# Copy this file to .env for local development.
# This file contains placeholders only. Never commit real credentials.

# Application
CODEFORGE_ENVIRONMENT=development
CODEFORGE_DEBUG=true
CODEFORGE_LOG_LEVEL=INFO
CODEFORGE_CORS_ORIGINS=http://localhost:3000

# Frontend
# For local frontend development, copy this value into frontend/.env.local.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
# Docker Compose builds the backend URL from POSTGRES_USER, POSTGRES_PASSWORD,
# and POSTGRES_DB. CODEFORGE_DATABASE_URL is for running the backend on the host.
POSTGRES_USER=codeforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codeforge
CODEFORGE_DATABASE_URL=postgresql+psycopg://codeforge:change-me@localhost:5432/codeforge

# LLM provider
# A real DEEPSEEK_API_KEY is required to execute workflow runs.
# Never place real API keys in this file or in Git.
CODEFORGE_LLM_PROVIDER=deepseek
CODEFORGE_LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
